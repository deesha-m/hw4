# Copy this file to .env in the hw4 folder and fill in your own values.
# Never commit .env. It's already listed in .gitignore.

# Portkey gateway key used for all model calls (required for the chat assistant).
PORTKEY_API_KEY=your-portkey-api-key-here

# Model used by the agent (optional; this is the default).
CAMPUS_CUSTOMS_MODEL=gpt-5.6-luna

# Long random string that signs login cookies (optional; without it, restarting the
# backend logs everyone out). Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=replace-with-a-long-random-string
